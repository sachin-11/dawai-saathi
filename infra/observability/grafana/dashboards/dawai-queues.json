                "color": "#2f9e44",
                "value": null
              },
              {
                "color": "#e03131",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no data",
                  "color": "#868e96"
