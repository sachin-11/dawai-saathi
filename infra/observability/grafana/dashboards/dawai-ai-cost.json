      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(llm_fallback_total{job=\"ai-service\"}[1h])) / clamp_min(sum(increase(llm_calls_total{job=\"ai-service\",status=\"ok\"}[1h])), 1)",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2f9e44",
                "value": null
              },
              {
                "color": "#e8b600",
                "value": 0.05
              },
              {
                "color": "#e03131",
                "value": 0.25
              }
            ]
          },
          "decimals": 1,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "no data",
