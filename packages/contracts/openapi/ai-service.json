{
  "components": {
    "schemas": {
      "ActiveMedication": {
        "additionalProperties": false,
        "properties": {
          "salt": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Salt",
            "type": "string"
          },
          "strength": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Strength",
            "type": "string"
          }
        },
        "required": ["salt", "strength"],
        "title": "ActiveMedication",
        "type": "object"
      },
      "DateField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "DateField",
        "type": "object"
      },
      "EmergencyCategory": {
        "description": "Why a message was treated as an emergency (shared with the keyword file's categories).",
        "enum": [
          "cardiac",
          "breathing",
          "unconscious",
          "bleeding",
          "poisoning_overdose",
          "seizure",
          "stroke",
          "severe_allergy",
          "self_harm"
        ],
        "title": "EmergencyCategory",
        "type": "string"
      },
      "FoodField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "enum": ["before", "after", "with", "any"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "FoodField",
        "type": "object"
      },
      "FormField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "enum": [
                  "tablet",
                  "capsule",
                  "syrup",
                  "injection",
                  "drops",
                  "cream",
                  "inhaler",
                  "powder",
                  "other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "FormField",
        "type": "object"
      },
      "InputPayload": {
        "additionalProperties": false,
        "properties": {
          "media_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Media Url"
          },
          "mime": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mime"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          },
          "type": {
            "$ref": "#/components/schemas/InputType"
          }
        },
        "required": ["type"],
        "title": "InputPayload",
        "type": "object"
      },
      "InputType": {
        "enum": ["image", "text", "audio"],
        "title": "InputType",
        "type": "string"
      },
      "IntField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "IntField",
        "type": "object"
      },
      "Intent": {
        "enum": [
          "prescription",
          "lab_report",
          "generic_query",
          "interaction_query",
          "help",
          "emergency",
          "greeting",
          "out_of_scope",
          "other"
        ],
        "title": "Intent",
        "type": "string"
      },
      "Language": {
        "enum": ["hi", "en"],
        "title": "Language",
        "type": "string"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status"],
        "title": "LivenessResponse",
        "type": "object"
      },
      "Medicine": {
        "additionalProperties": false,
        "properties": {
          "as_needed": {
            "default": false,
            "title": "As Needed",
            "type": "boolean"
          },
          "dose": {
            "$ref": "#/components/schemas/TextField"
          },
          "duration_days": {
            "$ref": "#/components/schemas/IntField"
          },
          "form": {
            "$ref": "#/components/schemas/FormField"
          },
          "frequency_code": {
            "$ref": "#/components/schemas/TextField"
          },
          "frequency_per_day": {
            "$ref": "#/components/schemas/IntField"
          },
          "instructions": {
            "$ref": "#/components/schemas/TextField"
          },
          "low_confidence": {
            "default": false,
            "title": "Low Confidence",
            "type": "boolean"
          },
          "name": {
            "$ref": "#/components/schemas/TextField"
          },
          "raw_text": {
            "$ref": "#/components/schemas/TextField"
          },
          "relation_to_food": {
            "$ref": "#/components/schemas/FoodField"
          },
          "strength": {
            "$ref": "#/components/schemas/TextField"
          },
          "timings": {
            "$ref": "#/components/schemas/TimingsField"
          },
          "validation_notes": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Validation Notes",
            "type": "array"
          }
        },
        "required": [
          "raw_text",
          "name",
          "form",
          "strength",
          "dose",
          "frequency_code",
          "frequency_per_day",
          "timings",
          "relation_to_food",
          "duration_days",
          "instructions"
        ],
        "title": "Medicine",
        "type": "object"
      },
      "Meta": {
        "properties": {
          "cost_usd": {
            "minimum": 0.0,
            "title": "Cost Usd",
            "type": "number"
          },
          "fallback_used": {
            "default": false,
            "title": "Fallback Used",
            "type": "boolean"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "integer"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "prompt_version": {
            "title": "Prompt Version",
            "type": "string"
          },
          "provider": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "required": ["prompt_version", "latency_ms", "cost_usd"],
        "title": "Meta",
        "type": "object"
      },
      "PrescriptionExtraction": {
        "additionalProperties": false,
        "properties": {
          "image_quality": {
            "enum": ["good", "poor", "unreadable"],
            "title": "Image Quality",
            "type": "string"
          },
          "is_prescription": {
            "title": "Is Prescription",
            "type": "boolean"
          },
          "kind": {
            "const": "prescription",
            "default": "prescription",
            "title": "Kind",
            "type": "string"
          },
          "medicines": {
            "items": {
              "$ref": "#/components/schemas/Medicine"
            },
            "maxItems": 20,
            "title": "Medicines",
            "type": "array"
          },
          "notes_for_user": {
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "title": "Notes For User",
            "type": "array"
          },
          "overall_confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Overall Confidence",
            "type": "number"
          },
          "prescription_date": {
            "$ref": "#/components/schemas/DateField"
          },
          "status": {
            "default": "done",
            "enum": ["done", "needs_review", "failed"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["is_prescription", "image_quality", "prescription_date"],
        "title": "PrescriptionExtraction",
        "type": "object"
      },
      "ProcessRequest": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/RequestContext"
          },
          "input": {
            "$ref": "#/components/schemas/InputPayload"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9._=+/-]{1,200}$",
            "title": "Request Id",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserContext"
          }
        },
        "required": ["request_id", "user", "input"],
        "title": "ProcessRequest",
        "type": "object"
      },
      "ProcessResponse": {
        "properties": {
          "emergency": {
            "default": false,
            "title": "Emergency",
            "type": "boolean"
          },
          "emergency_category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EmergencyCategory"
              },
              {
                "type": "null"
              }
            ]
          },
          "extraction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PrescriptionExtraction"
              },
              {
                "type": "null"
              }
            ]
          },
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "meta": {
            "$ref": "#/components/schemas/Meta"
          },
          "reply": {
            "$ref": "#/components/schemas/Reply"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9._=+/-]{1,200}$",
            "title": "Request Id",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": ["request_id", "intent", "reply", "meta"],
        "title": "ProcessResponse",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "db": {
            "enum": ["ok", "fail"],
            "title": "Db",
            "type": "string"
          },
          "llm_config": {
            "enum": ["ok", "fail"],
            "title": "Llm Config",
            "type": "string"
          }
        },
        "required": ["db", "llm_config"],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": ["ok", "degraded"],
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["status", "checks"],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "Reply": {
        "properties": {
          "buttons": {
            "items": {
              "$ref": "#/components/schemas/ReplyButton"
            },
            "maxItems": 3,
            "title": "Buttons",
            "type": "array"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "text": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": ["language", "text"],
        "title": "Reply",
        "type": "object"
      },
      "ReplyButton": {
        "properties": {
          "id": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "title": {
            "maxLength": 20,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": ["id", "title"],
        "title": "ReplyButton",
        "type": "object"
      },
      "RequestContext": {
        "additionalProperties": false,
        "properties": {
          "active_medications": {
            "items": {
              "$ref": "#/components/schemas/ActiveMedication"
            },
            "maxItems": 50,
            "title": "Active Medications",
            "type": "array"
          }
        },
        "title": "RequestContext",
        "type": "object"
      },
      "TextField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "TextField",
        "type": "object"
      },
      "TimingsField": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "value": {
            "anyOf": [
              {
                "items": {
                  "enum": ["morning", "afternoon", "evening", "night"],
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "title": "TimingsField",
        "type": "object"
      },
      "UserContext": {
        "additionalProperties": false,
        "properties": {
          "age": {
            "anyOf": [
              {
                "maximum": 120.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "language": {
            "$ref": "#/components/schemas/Language"
          },
          "sex": {
            "anyOf": [
              {
                "enum": ["m", "f"],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sex"
          }
        },
        "required": ["language"],
        "title": "UserContext",
        "type": "object"
      },
      "Warning": {
        "properties": {
          "detail": {
            "maxLength": 500,
            "title": "Detail",
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/WarningType"
          }
        },
        "required": ["type", "detail"],
        "title": "Warning",
        "type": "object"
      },
      "WarningType": {
        "enum": ["low_confidence", "interaction", "critical_value"],
        "title": "WarningType",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "Dawai Saathi AI Service",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "description": "Liveness: process is up. No dependency checks (that is /health/ready).",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": ["health"]
      }
    },
    "/health/ready": {
      "get": {
        "description": "Readiness: Postgres answers within 2 s and the LLM configuration is valid. 503 otherwise.",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": ["health"]
      }
    },
    "/v1/process": {
      "post": {
        "description": "Run one message through the pipeline and return a structured, WhatsApp-ready reply.",
        "operationId": "process_v1_process_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-service-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Service-Token"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "Missing or wrong X-Service-Token"
          },
          "413": {
            "description": "Request body too large"
          },
          "422": {
            "description": "Invalid request"
          },
          "502": {
            "description": "The language model failed or returned an unusable answer"
          },
          "503": {
            "description": "The language model is unavailable or not configured"
          },
          "504": {
            "description": "Processing took longer than PROCESS_TIMEOUT_S"
          }
        },
        "summary": "Process",
        "tags": ["process"]
      }
    }
  }
}
