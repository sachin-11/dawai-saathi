# common
NODE_ENV=development
LOG_LEVEL=info
SERVICE_TOKEN=change-me                 # gateway <-> ai-service
ENCRYPTION_KEY=ZGF3YWktbG9jYWwtZGV2LWtleS1ub3Qtc2VjcmV0ISE=  # AES-256-GCM for phone numbers: base64 of 32 bytes. LOCAL-ONLY public key; production: `openssl rand -base64 32`
PHONE_HASH_PEPPER=local-dev-pepper-change-me   # secret pepper for the phone hash; never change it once users exist

# whatsapp
WA_PHONE_NUMBER_ID=100000000000001      # numeric id from the Meta dashboard (fake value works locally)
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=local-dev-app-secret      # for X-Hub-Signature-256 (Meta app secret)
WA_VERIFY_TOKEN=local-dev-verify-token  # webhook verification (you choose it, paste it into the Meta dashboard)
WA_API_VERSION=v21.0

# data  (LOCAL-ONLY defaults, used by docker-compose.yml too — never reuse outside your machine)
POSTGRES_USER=dawai
POSTGRES_PASSWORD=dawai
POSTGRES_DB=dawai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dawai:dawai@localhost:5432/dawai        # gateway (Prisma, read/write)
AI_RO_PASSWORD=dawai_ai_ro                                        # password of the read-only DB role
AI_DATABASE_URL=postgresql://dawai_ai_ro:dawai_ai_ro@localhost:5432/dawai  # ai-service (read-only role); falls back to DATABASE_URL
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
S3_BUCKET=dawai-media
S3_ENDPOINT=http://localhost:9000       # MinIO locally; empty on AWS
S3_ACCESS_KEY_ID=dawai-minio            # MinIO root user locally; leave empty on AWS (IAM role)
S3_SECRET_ACCESS_KEY=dawai-minio-secret # leave empty on AWS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001                 # http://localhost:9001
AWS_REGION=ap-south-1
MEDIA_RETENTION_DAYS=30

# ai
AI_SERVICE_URL=http://localhost:8000
LLM_PRIMARY=anthropic                   # anthropic | openai
LLM_FALLBACK=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=
TEXT_MODEL=
CHEAP_MODEL=
STT_PROVIDER=whisper                    # whisper | sarvam
EXTRACTION_MIN_CONFIDENCE=0.75
PINECONE_API_KEY=
PINECONE_INDEX=dawai-drugs
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# workers
WORKERS_ENABLED=true                    # false = HTTP only, do not consume queues

# reminders
REMINDER_ACK_TIMEOUT_MIN=60
CAREGIVER_ALERT_AFTER_MISSES=2
