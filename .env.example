# common
NODE_ENV=development
LOG_LEVEL=info
SERVICE_TOKEN=change-me                 # gateway <-> ai-service
ENCRYPTION_KEY=ZGF3YWktbG9jYWwtZGV2LWtleS1ub3Qtc2VjcmV0ISE=  # AES-256-GCM for phone numbers: base64 of 32 bytes. LOCAL-ONLY public key; production: `openssl rand -base64 32`
PHONE_HASH_PEPPER=local-dev-pepper-change-me   # secret pepper for the phone hash; never change it once users exist

# whatsapp
WA_PHONE_NUMBER_ID=100000000000001      # numeric id from the Meta dashboard (fake value works locally)
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=local-dev-access-token  # Graph API bearer token (Meta dashboard -> WhatsApp -> API setup). Local fake value is fine until you test with real Meta
WA_APP_SECRET=local-dev-app-secret      # for X-Hub-Signature-256 (Meta app secret)
WA_VERIFY_TOKEN=local-dev-verify-token  # webhook verification (you choose it, paste it into the Meta dashboard)
WA_API_VERSION=v21.0
# WA_API_BASE_URL=https://graph.facebook.com   # only override for mocks
DEV_ECHO_BOT=false                      # DEV ONLY: echo replies without consent. Refused when NODE_ENV=production
PRIVACY_POLICY_URL=https://dawaisaathi.example/privacy   # shown in the consent message (real page: M16)
MAX_MEDIA_MB=10                         # inbound media above this is not downloaded
OUTBOUND_RATE_PER_SEC=20                # outbound send throughput cap

# data  (LOCAL-ONLY defaults, used by docker-compose.yml too — never reuse outside your machine)
POSTGRES_USER=dawai
POSTGRES_PASSWORD=dawai
POSTGRES_DB=dawai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dawai:dawai@localhost:5432/dawai        # gateway (Prisma, read/write)
AI_RO_PASSWORD=dawai_ai_ro                                        # password of the read-only DB role
AI_DATABASE_URL=postgresql://dawai_ai_ro:dawai_ai_ro@localhost:5432/dawai  # ai-service (read-only role); falls back to DATABASE_URL
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
S3_BUCKET=dawai-media
S3_ENDPOINT=http://localhost:9000       # MinIO locally; empty on AWS
S3_ACCESS_KEY_ID=dawai-minio            # MinIO root user locally; leave empty on AWS (IAM role)
S3_SECRET_ACCESS_KEY=dawai-minio-secret # leave empty on AWS
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001                 # http://localhost:9001
AWS_REGION=ap-south-1
MEDIA_RETENTION_DAYS=30
S3_AI_ENDPOINT=                           # optional: S3 hostname the AI service uses (e.g. http://minio:9000 from a container); empty = S3_ENDPOINT
MED_TIME_MORNING=08:00                    # clock times (Asia/Kolkata) a written morning/afternoon/evening/night is saved as
MED_TIME_AFTERNOON=14:00
MED_TIME_EVENING=18:00
MED_TIME_NIGHT=21:00
S3_SSE=AES256                           # server-side encryption for media; `none` only for a MinIO without a KMS key

# ai
AI_SERVICE_URL=http://localhost:8000
AI_CLIENT_TIMEOUT_MS=70000              # gateway -> ai-service request timeout (ai-service PROCESS_TIMEOUT_S is 60)
PROCESS_TIMEOUT_S=60                    # ai-service: max time for one /v1/process request
NODE_TIMEOUT_VISION_S=45                # M9 per-node limits (also capped by the request deadline)
NODE_TIMEOUT_CHEAP_S=10
NODE_TIMEOUT_COMPOSER_S=20
NODE_TIMEOUT_IO_S=20
NODE_TIMEOUT_FAST_S=5
GRAPH_RECURSION_LIMIT=25
DEMO_SERVICE_TOKEN=                     # M9/M16: optional (>= 16 chars, != SERVICE_TOKEN); only this caller may send options.include_trace
LLM_MODE=fake                           # fake = deterministic offline LLM (dev/tests); real = Anthropic/OpenAI. Production needs real
DRUG_TRGM_MIN=0.45                        # ai-service: minimum pg_trgm similarity for a fuzzy brand match
DRUG_MATCH_MIN=0.8                        # ai-service: below this score a match is shown but never used for a generic
DRUG_VECTOR_MIN=0.8                       # ai-service: minimum cosine similarity for the vector fallback
MIN_SAVINGS_PCT=15                        # ai-service: an alternative must be at least this much cheaper (when the brand price is known)
VECTOR_BACKEND=memory                     # ai-service: memory (index built from the catalog) | pinecone (make embed uploads it)
PINECONE_INDEX_HOST=                      # Pinecone data-plane host of the index (VECTOR_BACKEND=pinecone)
EMBEDDING_BASE_URL=                       # OpenAI-compatible embeddings endpoint (optional; offline embedder if empty)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
VISION_MAX_PX=2000                        # ai-service: longest image side sent to a vision model
LAB_MAX_PAGES=6                           # ai-service M12: pages of a lab-report PDF that are read (max 10)
IMAGE_MIN_SHARPNESS=12                    # ai-service: below this Laplacian variance a photo is refused as too blurry (no model call)
ALLOWED_MEDIA_HOSTS=localhost:9000,127.0.0.1:9000   # ai-service: hosts a presigned media URL may point to (MinIO locally, the S3 host in prod)
LLM_CALL_TIMEOUT_S=20                   # ai-service: timeout of ONE model call
LLM_MAX_ATTEMPTS=2                      # ai-service: attempts per provider before falling back
LLM_BREAKER_THRESHOLD=5                 # ai-service: consecutive failures before a provider is skipped
LLM_BREAKER_COOLDOWN_S=60               # ai-service: how long a failing provider is skipped
# ---- safety layer (M6, ai-service)
EMERGENCY_MIN_CONFIDENCE=0.5            # classifier verdicts at or above this count as an emergency (deliberately low)
EMERGENCY_CLASSIFIER_TIMEOUT_S=5        # past this the keyword rules alone decide; the request is never blocked
REDACTION_ENABLED=true                  # must be true in production (boot fails otherwise)
LLM_PRIMARY=anthropic                   # anthropic | openai
LLM_FALLBACK=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=                           # model ids per role for the PRIMARY provider (real mode)
TEXT_MODEL=
CHEAP_MODEL=                            # must accept images: it classifies the photo (image_classify_v1)
FALLBACK_VISION_MODEL=                  # model ids per role for the FALLBACK provider (names differ per provider)
FALLBACK_TEXT_MODEL=
FALLBACK_CHEAP_MODEL=
# voice notes (M13). Model ids / prices are configuration, never constants (pricing.yaml has the prices)
STT_PRIMARY=whisper                     # ai-service: whisper | sarvam
STT_FALLBACK=                           # ai-service: the other one (used on timeout / 429 / 5xx only)
STT_MODEL_WHISPER=                      # ai-service: e.g. the OpenAI transcription model id
STT_MODEL_SARVAM=                       # ai-service: e.g. the Sarvam speech-to-text model id (empty = provider default)
STT_SARVAM_MODE=                        # ai-service: Sarvam mode, e.g. codemix (Hinglish)
STT_SARVAM_MAX_S=30                     # ai-service: Sarvam REST is for short clips; longer notes go to the other provider
STT_LANGUAGE_MODE=user                  # ai-service: user (hint = the user's language) | auto (code-mixed speech)
STT_MIN_CONFIDENCE=0.35                 # ai-service: below this a transcript is "unclear" (asks to repeat, AFTER the emergency check)
MAX_AUDIO_SECONDS=120                   # ai-service: longer voice notes are not transcribed
SARVAM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FFMPEG_PATH=ffmpeg
TTS_ENABLED=false                       # gateway + ai-service: spoken replies (a user also needs VOICE ON)
TTS_PRIMARY=sarvam                      # ai-service: smallest | sarvam | openai
TTS_FALLBACK=                           # ai-service: comma separated, tried in order after the primary, e.g. sarvam,openai
SMALLEST_API_KEY=
TTS_MODEL_SMALLEST=                     # ai-service: e.g. lightning-v3.1 (v2 is retired)
TTS_VOICE_SMALLEST_HI=                  # ai-service: Smallest voice id for Hindi (the get_voices list)
TTS_VOICE_SMALLEST_EN=                  # ai-service: Smallest voice id for English
TTS_MODEL_SARVAM=
TTS_MODEL_OPENAI=
TTS_VOICE_OPENAI=
TTS_SPEAKER_HI=
TTS_SPEAKER_EN=
EXTRACTION_MIN_CONFIDENCE=0.75
PINECONE_API_KEY=
PINECONE_INDEX=dawai-drugs
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# observability, limits, cost guard (M15)
OTEL_EXPORTER_OTLP_ENDPOINT=            # e.g. http://localhost:4318 with `make up-obs`; empty = tracing off
OTEL_SAMPLE_RATIO=0.2                   # share of ordinary traces kept; errors and emergencies are always kept
METRICS_TOKEN=local-dev-metrics-token   # bearer token for GET /metrics (both apps); REQUIRED in production
SHUTDOWN_GRACE_S=25                     # workers get this long to finish jobs in flight on SIGTERM
WEBHOOK_RATE_LIMIT_PER_MIN=6000         # per IP on POST /webhook/whatsapp (was a fixed 300; found too low by the k6 smoke test)
RL_MSG_PER_MIN=10                       # per user; emergencies, DELETE and HELP bypass every limit
RL_MSG_PER_DAY=200
RL_DOCS_PER_DAY=20
RL_VOICE_PER_DAY=30
RL_CAREGIVER_INVITES_PER_DAY=3
RL_BLOCK_AFTER_WINDOWS=5                # limited windows in one day before an automatic block
RL_BLOCK_HOURS=24
LLM_DAILY_BUDGET_USD=                   # unset = guard off locally; REQUIRED in production (Asia/Kolkata day)
USER_DAILY_COST_USD=                    # one user's share of the day; unset = no per-user cap
BUDGET_ECONOMY_PCT=70                   # >= economy: cheap model for text calls, no spoken replies
BUDGET_ESSENTIAL_PCT=90                 # >= essential: only prescription reading + emergency + templates
MAX_COST_PER_REQUEST_USD=               # ai-service: stop a request that would pass this (asks for fewer pages)
COST_ESTIMATE_VISION_USD=0.03           # ai-service: projected cost of the next vision call (for the cap above)

# workers
WORKERS_ENABLED=true                    # false = HTTP only, do not consume queues

# reminders (M10)
REMINDER_ACK_TIMEOUT_MIN=60             # no answer after this = missed
CAREGIVER_ALERT_AFTER_MISSES=2          # missed times in a row before the caregiver gets an alert
REMINDER_HORIZON_HOURS=36               # the planner (every 15 min) materialises this far ahead
REMINDER_OPEN_ENDED_DAYS=30             # prescription without a duration: remind for this long, then ask
SNOOZE_MINUTES=30                       # "Baad me"; at most 2 per reminder
DAILY_SUMMARY_ENABLED=false             # evening "N of M doses taken" message
REMINDER_TEST_OFFSET_MIN=               # DEV ONLY: first reminder N minutes from now (refused in production)

# evals (M14)
EVAL_MAX_USD=                           # cost cap for `make eval MODE=real` (a real run refuses to start without it)
EVAL_VOICE_PROVIDERS=whisper,sarvam     # real voice eval: providers to measure
