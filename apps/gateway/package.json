{
  "name": "@dawai/gateway",
  "version": "0.0.0",
  "private": true,
  "description": "Dawai Saathi gateway — WhatsApp webhook, user state, queues (NestJS)",
  "files": [
    "dist",
    "prisma",
    "demo-cache",
    "admin-data"
  ],
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "predev": "node scripts/sync-admin-data.mjs",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" && prettier --check \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix && prettier --write \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --passWithNoTests && jest --config test/jest-e2e.json",
    "test:unit": "jest",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:cov": "jest --coverage",
    "postinstall": "prisma generate",
    "webhook": "ts-node scripts/send-test-webhook.ts",
    "cli": "ts-node scripts/cli.ts",
    "sync:admin-data": "node scripts/sync-admin-data.mjs",
    "demo-cache": "ts-node scripts/build-demo-cache.ts",
    "prisma:generate": "prisma generate",
    "contracts:types": "openapi-typescript ../../packages/contracts/openapi/ai-service.json -o src/ai-client/generated/ai-service.ts",
    "test:e2e-conversations": "jest --config test/jest-e2e-conversations.json --runInBand"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!main.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164",
    "@aws-sdk/lib-storage": "^3.1164",
    "@aws-sdk/s3-request-presigner": "^3.1164",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/core": "^3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/resources": "^3.1.0",
    "@opentelemetry/sdk-node": "^0.301.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@prisma/client": "6.19.3",
    "bullmq": "^6.7.2",
    "ioredis": "^5",
    "luxon": "3",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.34.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "3",
    "@types/multer": "^2.3.0",
    "@types/node": "20",
    "@types/supertest": "^7.2.1",
    "ajv": "^8",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "nock": "^14.0.17",
    "openapi-typescript": "^7",
    "prisma": "6.19.3",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "yaml": "2.9.1"
  }
}
