// Dawai Saathi data model — implements CLAUDE.md §6.
//
// Conventions
//  - DB names are snake_case (@map / @@map); TypeScript names are camelCase.
//  - All ids are UUIDs generated by the DB (gen_random_uuid(), pgcrypto) so raw SQL inserts work too.
//  - All timestamps are timestamptz.
//  - Everything a user owns cascades from `users`, so the DELETE command (M4) is one `DELETE FROM users`.
//    EXCEPTIONS (on purpose):
//      * audit_logs.user_id has NO foreign key — the anonymous `user_deleted` row must survive erasure.
//      * medications.drug_id is SetNull — `drugs` is a shared catalog, not user data.
//  - Things Prisma cannot express are added by hand to the init migration:
//      GIN trigram index on drugs.brand_name, CHECK (salt_a < salt_b) on interactions,
//      pg_trgm/pgcrypto extensions, SELECT grants for the read-only AI role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum Language {
  hi
  en

  @@map("language")
}

/// Where a user is in the first-contact flow (CLAUDE.md §7.1): pick a language, accept consent, done.
enum OnboardingStep {
  language
  consent
  done

  @@map("onboarding_step")
}

enum MessageDirection {
  in
  out

  @@map("message_direction")
}

enum MessageType {
  text
  image
  document
  audio
  button
  template
  /// Inbound types we do not process (sticker, location, video, reaction, ...). Saved so the
  /// worker can send a polite "I can't read this" reply (M4+). Added in M2; not in CLAUDE.md §6.
  unsupported

  @@map("message_type")
}

/// Delivery receipt state of an OUTBOUND message, from WhatsApp status webhooks (M3).
/// Only ever moves forward: sent < delivered < read. `failed` never overwrites delivered/read.
enum DeliveryStatus {
  sent
  delivered
  read
  failed

  @@map("delivery_status")
}

enum DocumentKind {
  prescription
  lab_report
  unknown

  @@map("document_kind")
}

enum DocumentStatus {
  queued
  processing
  done
  failed
  needs_review

  @@map("document_status")
}

enum RelationToFood {
  before
  after
  with
  any

  @@map("relation_to_food")
}

enum ReminderStatus {
  pending
  sent
  taken
  snoozed
  skipped
  missed
  cancelled

  @@map("reminder_status")
}

enum ReminderScheduleStatus {
  active
  paused
  completed
  cancelled

  @@map("reminder_schedule_status")
}

enum CaregiverStatus {
  pending
  verified
  declined
  removed

  @@map("caregiver_status")
}

enum InteractionSeverity {
  minor
  moderate
  major

  @@map("interaction_severity")
}

enum LabSex {
  any
  m
  f

  @@map("lab_sex")
}

enum AuditActor {
  user
  system
  admin

  @@map("audit_actor")
}

// ------------------------------------------------------------------ user-owned tables

model User {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Peppered SHA-256 of the phone number: used for lookup only.
  waPhoneHash       String         @unique @map("wa_phone_hash")
  /// AES-256-GCM ciphertext of the phone number: used for sending only.
  waPhoneEnc        String         @map("wa_phone_enc")
  language          Language       @default(hi)
  consentAt         DateTime?      @map("consent_at") @db.Timestamptz(6)
  /// No document is processed until this is `done` (consent-first, CLAUDE.md §2.7).
  onboardingStep    OnboardingStep @default(language) @map("onboarding_step")
  /// Version of the consent text the user accepted, e.g. "v1".
  consentVersion    String?        @map("consent_version")
  /// STOP REMINDERS / START REMINDERS. The reminder scheduler (M10) must respect this.
  remindersEnabled  Boolean        @default(true) @map("reminders_enabled")
  lastInboundAt     DateTime?      @map("last_inbound_at") @db.Timestamptz(6)
  /// M10: IANA zone all reminder times are computed in. Times are stored UTC.
  timezone          String         @default("Asia/Kolkata")
  /// M10: a snooze never moves a reminder into this window (local HH:MM).
  quietHoursStart   String         @default("22:30") @map("quiet_hours_start")
  quietHoursEnd     String         @default("06:30") @map("quiet_hours_end")
  /// M10: slots missed in a row; reset by any taken dose, drives the caregiver alert.
  consecutiveMisses Int            @default(0) @map("consecutive_misses")
  /// M13: VOICE ON / VOICE OFF. Spoken replies are an addition to the text reply (TTS_ENABLED too).
  voiceReplies      Boolean        @default(false) @map("voice_replies")
  /// M15: set by the abuse guard (or the operator CLI); until then every message but emergencies,
  /// DELETE and HELP gets one notice and is otherwise ignored.
  blockedUntil      DateTime?      @map("blocked_until") @db.Timestamptz(6)
  /// M15: a short machine token (`rate_limit`, `media_spam`, `operator`), never free text.
  blockReason       String?        @map("block_reason")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Set when the user confirms DELETE, while the erasure job runs: the conversation router ignores
  /// such users. This is only an in-flight marker; the job then HARD-deletes the row (§6).
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)

  caregivers         Caregiver[]
  messages           Message[]
  documents          Document[]
  medications        Medication[]
  reminders          Reminder[]
  medicationWarnings MedicationWarning[]
  labResults         LabResult[]
  reminderSchedules  ReminderSchedule[]

  @@map("users")
}

model Caregiver {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  waPhoneEnc    String          @map("wa_phone_enc")
  waPhoneHash   String          @map("wa_phone_hash")
  relation      String
  /// `relation` is the label the USER typed ("Papa"): the only name an alert ever shows.
  /// Set when the caregiver replies YES (M10).
  verifiedAt    DateTime?       @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  status        CaregiverStatus @default(pending)
  invitedAt     DateTime        @default(now()) @map("invited_at") @db.Timestamptz(6)
  /// The caregiver's own last message: opens THEIR 24 h window (they are not users).
  lastInboundAt DateTime?       @map("last_inbound_at") @db.Timestamptz(6)
  lastAlertAt   DateTime?       @map("last_alert_at") @db.Timestamptz(6)
  /// Alerts sent on `alertsDay` (local date), for the 3-per-day cap.
  alertsToday   Int             @default(0) @map("alerts_today")
  alertsDay     DateTime?       @map("alerts_day") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, waPhoneHash])
  @@index([waPhoneHash])
  @@map("caregivers")
}

model Message {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  direction       MessageDirection
  /// WhatsApp message id. UNIQUE = inbound dedupe (webhooks are delivered at-least-once).
  waMessageId     String           @unique @map("wa_message_id")
  type            MessageType
  /// Redacted text only (no raw PHI). Null for pure media messages.
  bodyRedacted    String?          @map("body_redacted")
  mediaS3Key      String?          @map("media_s3_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Outbound only: latest delivery receipt from Meta.
  deliveryStatus  DeliveryStatus?  @map("delivery_status")
  statusUpdatedAt DateTime?        @map("status_updated_at") @db.Timestamptz(6)
  /// Outbound only: Meta error code of a failed delivery (text: codes are opaque to us).
  errorCode       String?          @map("error_code")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// At most one document per inbound message: makes re-processing a message idempotent (M7).
  document Document?

  @@index([userId, createdAt])
  @@map("messages")
}

model Document {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  messageId         String         @unique @map("message_id") @db.Uuid
  kind              DocumentKind   @default(unknown)
  s3Key             String         @map("s3_key")
  status            DocumentStatus @default(queued)
  /// Structured AI output (PrescriptionExtraction / LabReportExtraction). Null until processed.
  extraction        Json?
  overallConfidence Decimal?       @map("overall_confidence") @db.Decimal(4, 3)
  promptVersion     String?        @map("prompt_version")
  model             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  medications Medication[]
  labResults  LabResult[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("documents")
}

model Medication {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  rawName         String         @map("raw_name")
  /// Catalog match (null when no confident match). Catalog is shared, so SetNull not Cascade.
  drugId          String?        @map("drug_id") @db.Uuid
  /// salt / strength / form / dose are null when they could not be read or matched
  /// (low-confidence items are flagged to the user, never guessed — CLAUDE.md §2.3).
  salt            String?
  strength        String?
  form            String?
  dose            String?
  /// Null for as-needed (SOS) medicines (M7).
  frequencyPerDay Int?           @map("frequency_per_day")
  asNeeded        Boolean        @default(false) @map("as_needed")
  /// M8 catalog match (null before the match ran or when the AI service had no catalog).
  saltKey         String?        @map("salt_key")
  strengthKey     String?        @map("strength_key")
  formKey         String?        @map("form_key")
  releaseType     ReleaseType?   @map("release_type")
  matchScore      Decimal?       @map("match_score") @db.Decimal(4, 3)
  matchMethod     MatchMethod?   @map("match_method")
  /// e.g. ["08:00", "20:00"], Asia/Kolkata wall-clock.
  timings         String[]
  relationToFood  RelationToFood @default(any) @map("relation_to_food")
  durationDays    Int?           @map("duration_days")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  confidence      Decimal        @db.Decimal(4, 3)
  active          Boolean        @default(true)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  drug              Drug?              @relation(fields: [drugId], references: [id], onDelete: SetNull)
  reminders         Reminder[]
  reminderSchedules ReminderSchedule[]

  @@index([userId, active])
  @@index([documentId])
  @@index([drugId])
  @@map("medications")
}

model ReminderSchedule {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  /// One schedule per medication (re-creating it updates this row).
  medicationId      String                 @unique @map("medication_id") @db.Uuid
  /// Local wall-clock times, e.g. ["08:00", "21:00"].
  times             String[]
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime?              @map("end_date") @db.Date
  timezone          String                 @default("Asia/Kolkata")
  status            ReminderScheduleStatus @default(active)
  /// Set when the "your reminders end tomorrow" message was sent (open-ended prescriptions).
  renewalNotifiedAt DateTime?              @map("renewal_notified_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  reminders  Reminder[]

  @@index([status])
  @@index([userId])
  @@map("reminder_schedules")
}

model Reminder {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId   String         @map("schedule_id") @db.Uuid
  medicationId String         @map("medication_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  scheduledAt  DateTime       @map("scheduled_at") @db.Timestamptz(6)
  status       ReminderStatus @default(pending)
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(6)
  ackAt        DateTime?      @map("ack_at") @db.Timestamptz(6)
  snoozeCount  Int            @default(0) @map("snooze_count")
  /// Meta message id of the grouped slot message (one message per user and slot).
  waMessageId  String?        @map("wa_message_id")
  /// BullMQ id of the slot job: `rem_<userId>_<epoch seconds>`.
  jobId        String         @map("job_id")

  schedule   ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  medication Medication       @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, scheduledAt])
  /// The reminder worker's hot query: "what is due?"
  @@index([status, scheduledAt])
  @@index([userId, scheduledAt])
  @@index([medicationId])
  @@map("reminders")
}

// ------------------------------------------------------------------ catalog tables (shared, read-only for the AI service)

model Drug {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandName       String      @map("brand_name")
  /// Normalised, lowercase alphanumerics only ("dolo650"): the lookup key for brand matching (M8).
  brandKey        String?     @map("brand_key")
  /// Normalised: sorted, lowercase salts joined with " + ". Kept from M1; `saltKey` is the matching key.
  saltComposition String      @map("salt_composition")
  strength        String
  form            String
  /// M8 canonical keys. A generic is only ever suggested when ALL FOUR are equal (CLAUDE.md §2.4).
  saltKey         String?     @map("salt_key")
  strengthKey     String?     @map("strength_key")
  formKey         String?     @map("form_key")
  releaseType     ReleaseType @default(na) @map("release_type")
  packSize        String?     @map("pack_size")
  packQty         Decimal?    @map("pack_qty") @db.Decimal(10, 2)
  packUnit        String?     @map("pack_unit")
  mrp             Decimal?    @db.Decimal(10, 2)
  /// mrp / pack_qty. Null when the price or pack size is unknown (then no savings are ever shown).
  pricePerUnit    Decimal?    @map("price_per_unit") @db.Decimal(12, 4)
  priceSourceDate DateTime?   @map("price_source_date") @db.Date
  manufacturer    String?
  isGeneric       Boolean     @default(false) @map("is_generic")
  isJanaushadhi   Boolean     @default(false) @map("is_janaushadhi")
  janaushadhiCode String?     @map("janaushadhi_code")
  /// Dataset + licence the row came from (CLAUDE.md M8: always record the source).
  source          String
  /// Id of the row inside its source (drug code, or a catalog key): upsert key together with `source`.
  sourceRef       String?     @map("source_ref")

  medications Medication[]

  // GIN trigram indexes (brand_key, salt_key) are created in the migration SQL: Prisma cannot model them.
  @@unique([source, sourceRef])
  @@index([saltComposition, strength, form])
  @@index([saltKey, strengthKey, formKey, releaseType])
  @@index([brandKey])
  @@map("drugs")
}

/// Different names for the same ingredient ("acetaminophen" -> "paracetamol"). Mirror of the in-repo
/// dictionary `apps/ai-service/app/catalog/salt_aliases.py`, written by `make seed`.
model SaltAlias {
  alias     String @id
  canonical String

  @@map("salt_aliases")
}

enum ReleaseType {
  ir
  sr
  er
  xr
  cr
  mr
  dr
  na

  @@map("release_type")
}

enum MatchMethod {
  exact
  trgm
  vector
  salt_written
  none

  @@map("match_method")
}

model Interaction {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Invariant (CHECK in migration): saltA < saltB, so each pair is stored once.
  saltA         String              @map("salt_a")
  saltB         String              @map("salt_b")
  severity      InteractionSeverity
  summary       String
  source        String
  /// M11: curated core list. Salts are canonical keys (same as drugs.salt_key components).
  mechanism     String?
  /// Stable code of the clinical effect (bleeding, serotonin_syndrome, ...). The bot words it from a
  /// reviewed table keyed by this code; the Hindi wording never comes from a model.
  effectCode    String              @default("") @map("effect_code")
  managementEn  String              @default("") @map("management_en")
  /// Generic safe Hindi line until a human reviewed the text (hi_reviewed).
  managementHi  String              @default("") @map("management_hi")
  hiReviewed    Boolean             @default(false) @map("hi_reviewed")
  evidenceLevel String?             @map("evidence_level")
  sourceRef     String?             @map("source_ref")
  sourceVersion String?             @map("source_version")

  warnings MedicationWarning[]

  @@unique([saltA, saltB])
  @@map("interactions")
}

enum MedicationWarningType {
  interaction
  duplicate_ingredient

  @@map("medication_warning_type")
}

enum MedicationWarningStatus {
  active
  acknowledged
  resolved

  @@map("medication_warning_status")
}

/// M11: findings of the interaction checker, so they can be listed and are not repeated.
/// A partial UNIQUE index (user_id, type, salt_a, salt_b) WHERE status = 'active' is hand-written in
/// the migration (Prisma cannot model it); `prisma migrate dev` proposes to drop it: delete that line.
model MedicationWarning {
  id            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                  @map("user_id") @db.Uuid
  type          MedicationWarningType
  medicationIds String[]                @map("medication_ids") @db.Uuid
  saltA         String                  @map("salt_a")
  saltB         String                  @map("salt_b")
  /// Null for a duplicate ingredient (same salt twice, no pair severity).
  severity      InteractionSeverity?
  interactionId String?                 @map("interaction_id") @db.Uuid
  status        MedicationWarningStatus @default(active)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation(fields: [interactionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@map("medication_warnings")
}

model LabTest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String
  name          String
  aliases       String[]
  unit          String
  refLow        Decimal? @map("ref_low")
  refHigh       Decimal? @map("ref_high")
  sex           LabSex   @default(any)
  ageMin        Int?     @map("age_min")
  ageMax        Int?     @map("age_max")
  explanationEn String   @map("explanation_en")
  explanationHi String   @map("explanation_hi")
  source        String
  // ---- M12. `unit` above is the CANONICAL unit; one row per (code, sex, age band) of fallback ranges.
  section             String   @default("")
  /// {"<normalised printed unit>": factor | {"f": factor, "o": offset}}: canonical = printed * f + o
  unitConversions     Json     @default("{}") @map("unit_conversions")
  /// Copied from app/safety/critical_values.yaml by the seed (the yaml is the source of truth).
  criticalLow         Decimal? @map("critical_low")
  criticalHigh        Decimal? @map("critical_high")
  doctorQuestionsEn   String[] @map("doctor_questions_en")
  doctorQuestionsHi   String[] @map("doctor_questions_hi")
  /// Words that mean "normal" for a qualitative test (urine protein: negative, nil, ...).
  qualitativeNormal   String[] @map("qualitative_normal")
  /// False until a human reviewed the Hindi text; until then the reply shows no Hindi explanation.
  hiReviewed          Boolean  @default(false) @map("hi_reviewed")

  @@index([code])
  @@map("lab_tests")
}

enum LabResultStatus {
  normal
  high
  low
  borderline
  critical_high
  critical_low
  qualitative_abnormal
  unknown

  @@map("lab_result_status")
}

/// M12: one row per result of a lab report, for trends and the REPORTS command. Holds no name, lab or
/// patient id. Rows of a document marked "something is wrong" (status needs_review) are left out of trends.
model LabResult {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  documentId         String          @map("document_id") @db.Uuid
  /// Null for a test the catalog does not know ("other tests").
  testCode           String?         @map("test_code")
  valueNumCanonical  Decimal?        @map("value_num_canonical")
  unitCanonical      String?         @map("unit_canonical")
  valueRaw           String          @map("value_raw")
  unitRaw            String?         @map("unit_raw")
  status             LabResultStatus
  reportDate         DateTime?       @map("report_date") @db.Date
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([userId, testCode, reportDate])
  @@index([documentId])
  @@map("lab_results")
}

// ------------------------------------------------------------------ audit

/// Deliberately has NO relation to User: rows must outlive the user (DPDP erasure keeps one anonymous row).
model AuditLog {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor     AuditActor
  userId    String?    @map("user_id") @db.Uuid
  action    String
  metadata  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
