// Dawai Saathi data model — implements CLAUDE.md §6.
//
// Conventions
//  - DB names are snake_case (@map / @@map); TypeScript names are camelCase.
//  - All ids are UUIDs generated by the DB (gen_random_uuid(), pgcrypto) so raw SQL inserts work too.
//  - All timestamps are timestamptz.
//  - Everything a user owns cascades from `users`, so the DELETE command (M4) is one `DELETE FROM users`.
//    EXCEPTIONS (on purpose):
//      * audit_logs.user_id has NO foreign key — the anonymous `user_deleted` row must survive erasure.
//      * medications.drug_id is SetNull — `drugs` is a shared catalog, not user data.
//  - Things Prisma cannot express are added by hand to the init migration:
//      GIN trigram index on drugs.brand_name, CHECK (salt_a < salt_b) on interactions,
//      pg_trgm/pgcrypto extensions, SELECT grants for the read-only AI role.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum Language {
  hi
  en

  @@map("language")
}

enum MessageDirection {
  in
  out

  @@map("message_direction")
}

enum MessageType {
  text
  image
  document
  audio
  button
  template
  /// Inbound types we do not process (sticker, location, video, reaction, ...). Saved so the
  /// worker can send a polite "I can't read this" reply (M4+). Added in M2; not in CLAUDE.md §6.
  unsupported

  @@map("message_type")
}

/// Delivery receipt state of an OUTBOUND message, from WhatsApp status webhooks (M3).
/// Only ever moves forward: sent < delivered < read. `failed` never overwrites delivered/read.
enum DeliveryStatus {
  sent
  delivered
  read
  failed

  @@map("delivery_status")
}

enum DocumentKind {
  prescription
  lab_report
  unknown

  @@map("document_kind")
}

enum DocumentStatus {
  queued
  processing
  done
  failed
  needs_review

  @@map("document_status")
}

enum RelationToFood {
  before
  after
  with
  any

  @@map("relation_to_food")
}

enum ReminderStatus {
  pending
  sent
  taken
  missed
  cancelled

  @@map("reminder_status")
}

enum InteractionSeverity {
  minor
  moderate
  major

  @@map("interaction_severity")
}

enum LabSex {
  any
  m
  f

  @@map("lab_sex")
}

enum AuditActor {
  user
  system
  admin

  @@map("audit_actor")
}

// ------------------------------------------------------------------ user-owned tables

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Peppered SHA-256 of the phone number: used for lookup only.
  waPhoneHash   String    @unique @map("wa_phone_hash")
  /// AES-256-GCM ciphertext of the phone number: used for sending only.
  waPhoneEnc    String    @map("wa_phone_enc")
  language      Language  @default(hi)
  consentAt     DateTime? @map("consent_at") @db.Timestamptz(6)
  lastInboundAt DateTime? @map("last_inbound_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  caregivers  Caregiver[]
  messages    Message[]
  documents   Document[]
  medications Medication[]
  reminders   Reminder[]

  @@map("users")
}

model Caregiver {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  waPhoneEnc  String    @map("wa_phone_enc")
  waPhoneHash String    @map("wa_phone_hash")
  relation    String
  /// Set when the caregiver replies YES (M10).
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, waPhoneHash])
  @@index([waPhoneHash])
  @@map("caregivers")
}

model Message {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @map("user_id") @db.Uuid
  direction       MessageDirection
  /// WhatsApp message id. UNIQUE = inbound dedupe (webhooks are delivered at-least-once).
  waMessageId     String           @unique @map("wa_message_id")
  type            MessageType
  /// Redacted text only (no raw PHI). Null for pure media messages.
  bodyRedacted    String?          @map("body_redacted")
  mediaS3Key      String?          @map("media_s3_key")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Outbound only: latest delivery receipt from Meta.
  deliveryStatus  DeliveryStatus?  @map("delivery_status")
  statusUpdatedAt DateTime?        @map("status_updated_at") @db.Timestamptz(6)
  /// Outbound only: Meta error code of a failed delivery (text: codes are opaque to us).
  errorCode       String?          @map("error_code")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([userId, createdAt])
  @@map("messages")
}

model Document {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  messageId         String         @map("message_id") @db.Uuid
  kind              DocumentKind   @default(unknown)
  s3Key             String         @map("s3_key")
  status            DocumentStatus @default(queued)
  /// Structured AI output (PrescriptionExtraction / LabReportExtraction). Null until processed.
  extraction        Json?
  overallConfidence Decimal?       @map("overall_confidence") @db.Decimal(4, 3)
  promptVersion     String?        @map("prompt_version")
  model             String?
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  medications Medication[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("documents")
}

model Medication {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  documentId      String         @map("document_id") @db.Uuid
  rawName         String         @map("raw_name")
  /// Catalog match (null when no confident match). Catalog is shared, so SetNull not Cascade.
  drugId          String?        @map("drug_id") @db.Uuid
  /// salt / strength / form / dose are null when they could not be read or matched
  /// (low-confidence items are flagged to the user, never guessed — CLAUDE.md §2.3).
  salt            String?
  strength        String?
  form            String?
  dose            String?
  frequencyPerDay Int            @map("frequency_per_day")
  /// e.g. ["08:00", "20:00"], Asia/Kolkata wall-clock.
  timings         String[]
  relationToFood  RelationToFood @default(any) @map("relation_to_food")
  durationDays    Int?           @map("duration_days")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  confidence      Decimal        @db.Decimal(4, 3)
  active          Boolean        @default(true)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  drug      Drug?      @relation(fields: [drugId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, active])
  @@index([documentId])
  @@index([drugId])
  @@map("medications")
}

model Reminder {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicationId String         @map("medication_id") @db.Uuid
  userId       String         @map("user_id") @db.Uuid
  scheduledAt  DateTime       @map("scheduled_at") @db.Timestamptz(6)
  status       ReminderStatus @default(pending)
  sentAt       DateTime?      @map("sent_at") @db.Timestamptz(6)
  ackAt        DateTime?      @map("ack_at") @db.Timestamptz(6)

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The reminder worker's hot query: "what is due?"
  @@index([status, scheduledAt])
  @@index([userId])
  @@index([medicationId])
  @@map("reminders")
}

// ------------------------------------------------------------------ catalog tables (shared, read-only for the AI service)

model Drug {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandName       String   @map("brand_name")
  /// Normalised: sorted, lowercase salts joined with " + ". Exact-match key for the generic finder.
  saltComposition String   @map("salt_composition")
  strength        String
  form            String
  packSize        String?  @map("pack_size")
  mrp             Decimal? @db.Decimal(10, 2)
  manufacturer    String?
  isGeneric       Boolean  @default(false) @map("is_generic")
  janaushadhiCode String?  @map("janaushadhi_code")
  /// Dataset + licence the row came from (CLAUDE.md M8: always record the source).
  source          String

  medications Medication[]

  // The GIN trigram index on brand_name (gin_trgm_ops) is created in the migration SQL.
  @@index([saltComposition, strength, form])
  @@map("drugs")
}

model Interaction {
  id       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Invariant (CHECK in migration): saltA < saltB, so each pair is stored once.
  saltA    String              @map("salt_a")
  saltB    String              @map("salt_b")
  severity InteractionSeverity
  summary  String
  source   String

  @@unique([saltA, saltB])
  @@map("interactions")
}

model LabTest {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String
  name          String
  aliases       String[]
  unit          String
  refLow        Decimal? @map("ref_low")
  refHigh       Decimal? @map("ref_high")
  sex           LabSex   @default(any)
  ageMin        Int?     @map("age_min")
  ageMax        Int?     @map("age_max")
  explanationEn String   @map("explanation_en")
  explanationHi String   @map("explanation_hi")
  source        String

  @@index([code])
  @@map("lab_tests")
}

// ------------------------------------------------------------------ audit

/// Deliberately has NO relation to User: rows must outlive the user (DPDP erasure keeps one anonymous row).
model AuditLog {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actor     AuditActor
  userId    String?    @map("user_id") @db.Uuid
  action    String
  metadata  Json       @default("{}")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}
