{
  "name": "@dawai/web",
  "version": "0.0.0",
  "private": true,
  "description": "Dawai Saathi web app: landing, demo playground and admin (Next.js 15)",
  "scripts": {
    "prebuild": "node scripts/prepare-build.mjs",
    "predev": "node scripts/prepare-build.mjs",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint . && prettier --check \"{app,components,lib,content,messages,scripts,tests,e2e}/**/*.{ts,tsx,json,mjs}\"",
    "lint:fix": "eslint . --fix && prettier --write \"{app,components,lib,content,messages,scripts,tests,e2e}/**/*.{ts,tsx,json,mjs}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.json"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.70.0",
    "next": "15.5.29",
    "next-auth": "4.24.15",
    "next-intl": "4.14.9",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "jsdom": "31.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  }
}
