# apps/web — copy to apps/web/.env.local. Server-only values must NEVER start with NEXT_PUBLIC_.
NEXT_PUBLIC_WA_NUMBER=919999999999        # digits only, with country code (wa.me link + QR)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-account/dawai-saathi
NEXT_PUBLIC_CONTACT_EMAIL=privacy@dawaisaathi.example
NEXT_PUBLIC_TURNSTILE_SITE_KEY=           # public by design (Cloudflare Turnstile site key); empty = dev
# --- server-only ---
GATEWAY_URL=http://localhost:3000
DEMO_API_KEY=local-dev-demo-key-change-me-0123
TURNSTILE_SECRET_KEY=                     # gateway verifies; the web server does not need it
NEXTAUTH_SECRET=local-dev-nextauth-secret-change-me-0123456789
NEXTAUTH_URL=http://localhost:3001
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_EMAILS=you@example.com
ADMIN_JWT_SECRET=local-dev-admin-jwt-secret-change-me-0123456789
GRAFANA_URL=http://localhost:3003
LANGFUSE_URL=http://localhost:3002
# Test only (Playwright): enables a credentials login. Refused when NODE_ENV=production.
ADMIN_TEST_LOGIN=false
